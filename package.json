{
  "name": "tga-winners",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bolão The Game Awards - Aplicação minimalista em dark mode",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
